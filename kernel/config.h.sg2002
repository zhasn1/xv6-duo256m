// Milk-V Duo 256M (SG2002, C906)
//
// 04140000 -- uart0 (DesignWare 8250, 4-byte register stride)
// 70000000 -- PLIC
// 80000000 -- OpenSBI (0x80000000-0x8003FFFF)
// 80200000 -- U-Boot puts the kernel here
// 8FE00000 -- FreeRTOS on the small core
#define DUO 1

#define UART0     0x04140000L
#define UART0_IRQ 44
#define PLIC      0x70000000L
#define KERNBASE  0x80200000L
#define PHYSTOP   0x8FE00000L
#define INTERVAL  250000
